"""
Pipeline bio-informatique simplifié — Exercice 3, Jour 4
Formation Bio-informatique INSP 2026

FastQC (brut) -> Fastp (nettoyage) -> FastQC (nettoyé) -> Kraken2 [-> Bracken]
[-> Krona] -> MultiQC (rapport consolidé)

Utilisation :
    snakemake -n --cores 2          # dry-run : affiche le plan d'exécution
    snakemake --cores 2             # exécution réelle
    snakemake --cores 2 --use-conda # exécution avec environnements conda dédiés
    snakemake --dag | dot -Tpng > dag.png   # schéma du graphe de dépendances
"""

configfile: "config.yaml"

SAMPLES = config["samples"]
RAW_DIR = config["raw_dir"]
RESULTS = config["results_dir"]
THREADS = config.get("threads", 2)


def pipeline_targets():
    """Construit dynamiquement la liste des fichiers finaux attendus,
    selon les étapes activées dans config.yaml."""
    targets = [
        f"{RESULTS}/multiqc/multiqc_report.html",
    ]
    if config.get("run_kraken2", True):
        targets += expand(f"{RESULTS}/kraken2/{{sample}}.kraken2.report.txt", sample=SAMPLES)
    if config.get("run_bracken", False):
        targets += expand(f"{RESULTS}/bracken/{{sample}}.bracken.txt", sample=SAMPLES)
    if config.get("run_krona", False):
        targets += expand(f"{RESULTS}/krona/{{sample}}.krona.html", sample=SAMPLES)
    return targets


rule all:
    input:
        pipeline_targets()


# -----------------------------------------------------------------------
# 1. FastQC sur les données brutes
# -----------------------------------------------------------------------
rule fastqc_raw:
    input:
        r1=f"{RAW_DIR}/{{sample}}_R1.fastq.gz",
        r2=f"{RAW_DIR}/{{sample}}_R2.fastq.gz",
    output:
        html1=f"{RESULTS}/fastqc_raw/{{sample}}_R1_fastqc.html",
        html2=f"{RESULTS}/fastqc_raw/{{sample}}_R2_fastqc.html",
    log:
        f"{RESULTS}/logs/fastqc_raw_{{sample}}.log",
    threads: THREADS
    conda:
        "envs/fastqc.yaml"
    shell:
        """
        mkdir -p {RESULTS}/fastqc_raw {RESULTS}/logs
        fastqc {input.r1} {input.r2} -o {RESULTS}/fastqc_raw -t {threads} > {log} 2>&1
        """


# -----------------------------------------------------------------------
# 2. Fastp : trimming des adaptateurs et filtrage qualité
# -----------------------------------------------------------------------
rule fastp:
    input:
        r1=f"{RAW_DIR}/{{sample}}_R1.fastq.gz",
        r2=f"{RAW_DIR}/{{sample}}_R2.fastq.gz",
    output:
        r1=f"{RESULTS}/fastp/{{sample}}_clean_R1.fastq.gz",
        r2=f"{RESULTS}/fastp/{{sample}}_clean_R2.fastq.gz",
        json=f"{RESULTS}/fastp/{{sample}}.fastp.json",
        html=f"{RESULTS}/fastp/{{sample}}.fastp.html",
    params:
        qual=config["fastp"]["qualified_quality_phred"],
        minlen=config["fastp"]["length_required"],
    log:
        f"{RESULTS}/logs/fastp_{{sample}}.log",
    threads: THREADS
    conda:
        "envs/fastp.yaml"
    shell:
        """
        mkdir -p {RESULTS}/fastp {RESULTS}/logs
        fastp \
            -i {input.r1} -I {input.r2} \
            -o {output.r1} -O {output.r2} \
            --detect_adapter_for_pe \
            --qualified_quality_phred {params.qual} \
            --length_required {params.minlen} \
            --json {output.json} --html {output.html} \
            --thread {threads} > {log} 2>&1
        """


# -----------------------------------------------------------------------
# 3. FastQC sur les données nettoyées (contrôle de l'amélioration)
# -----------------------------------------------------------------------
rule fastqc_clean:
    input:
        r1=f"{RESULTS}/fastp/{{sample}}_clean_R1.fastq.gz",
        r2=f"{RESULTS}/fastp/{{sample}}_clean_R2.fastq.gz",
    output:
        html1=f"{RESULTS}/fastqc_clean/{{sample}}_clean_R1_fastqc.html",
        html2=f"{RESULTS}/fastqc_clean/{{sample}}_clean_R2_fastqc.html",
    log:
        f"{RESULTS}/logs/fastqc_clean_{{sample}}.log",
    threads: THREADS
    conda:
        "envs/fastqc.yaml"
    shell:
        """
        mkdir -p {RESULTS}/fastqc_clean
        fastqc {input.r1} {input.r2} -o {RESULTS}/fastqc_clean -t {threads} > {log} 2>&1
        """


# -----------------------------------------------------------------------
# 4. Kraken2 : classification taxonomique
# -----------------------------------------------------------------------
rule kraken2:
    input:
        r1=f"{RESULTS}/fastp/{{sample}}_clean_R1.fastq.gz",
        r2=f"{RESULTS}/fastp/{{sample}}_clean_R2.fastq.gz",
    output:
        report=f"{RESULTS}/kraken2/{{sample}}.kraken2.report.txt",
        out=f"{RESULTS}/kraken2/{{sample}}.kraken2.output.txt",
    params:
        db=config["kraken2_db"],
    log:
        f"{RESULTS}/logs/kraken2_{{sample}}.log",
    threads: THREADS
    conda:
        "envs/kraken2.yaml"
    shell:
        """
        mkdir -p {RESULTS}/kraken2
        kraken2 --db {params.db} --paired {input.r1} {input.r2} \
            --report {output.report} --output {output.out} \
            --threads {threads} > {log} 2>&1
        """


# -----------------------------------------------------------------------
# 5. Bracken : ré-estimation des abondances (nécessite bioconda::bracken)
# -----------------------------------------------------------------------
rule bracken:
    input:
        report=f"{RESULTS}/kraken2/{{sample}}.kraken2.report.txt",
    output:
        f"{RESULTS}/bracken/{{sample}}.bracken.txt",
    params:
        db=config["kraken2_db"],
        readlen=config["bracken_read_len"],
        level=config["bracken_level"],
    log:
        f"{RESULTS}/logs/bracken_{{sample}}.log",
    conda:
        "envs/kraken2.yaml"
    shell:
        """
        mkdir -p {RESULTS}/bracken
        bracken -d {params.db} -i {input.report} \
            -o {output} -r {params.readlen} -l {params.level} > {log} 2>&1
        """


# -----------------------------------------------------------------------
# 6. Krona : visualisation interactive (nécessite KronaTools)
# -----------------------------------------------------------------------
rule krona:
    input:
        report=f"{RESULTS}/kraken2/{{sample}}.kraken2.report.txt",
    output:
        html=f"{RESULTS}/krona/{{sample}}.krona.html",
    params:
        txt=f"{RESULTS}/krona/{{sample}}.krona.txt",
    log:
        f"{RESULTS}/logs/krona_{{sample}}.log",
    shell:
        """
        mkdir -p {RESULTS}/krona
        kreport2krona.py -r {input.report} -o {params.txt} > {log} 2>&1
        ktImportText {params.txt} -o {output.html} >> {log} 2>&1
        """


# -----------------------------------------------------------------------
# 7. MultiQC : rapport consolidé (FastQC brut + nettoyé + Fastp)
# -----------------------------------------------------------------------
rule multiqc:
    input:
        expand(f"{RESULTS}/fastqc_raw/{{sample}}_R1_fastqc.html", sample=SAMPLES),
        expand(f"{RESULTS}/fastqc_clean/{{sample}}_clean_R1_fastqc.html", sample=SAMPLES),
        expand(f"{RESULTS}/fastp/{{sample}}.fastp.json", sample=SAMPLES),
    output:
        f"{RESULTS}/multiqc/multiqc_report.html",
    log:
        f"{RESULTS}/logs/multiqc.log",
    conda:
        "envs/multiqc.yaml"
    shell:
        """
        mkdir -p {RESULTS}/multiqc
        multiqc {RESULTS}/fastqc_raw {RESULTS}/fastqc_clean {RESULTS}/fastp \
            -o {RESULTS}/multiqc -n multiqc_report > {log} 2>&1
        """
